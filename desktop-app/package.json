{
  "name": "handdy-desktop-app",
  "version": "1.2.32",
  "description": "Employee Time & Attendance System Desktop App",
  "main": "main.js",
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.js && npm run test:electron && npm run test:dashboard",
    "test:electron": "set \"ELECTRON_RUN_AS_NODE=\" && electron test/electron-inactivity-smoke.cjs",
    "test:installer": "powershell -NoProfile -File test/installer-shortcut-smoke.ps1",
    "test:dashboard": "set \"VITE_API_URL=/api\" && npm --prefix ../dashboard run build && set \"ELECTRON_RUN_AS_NODE=\" && electron test/dashboard-lifecycle-smoke.cjs",
    "start": "set \"ELECTRON_RUN_AS_NODE=\" && electron .",
    "build": "electron-builder --win nsis --x64 --publish never",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:signed": "electron-builder --win nsis --x64 --publish never --config.forceCodeSigning=true",
    "publish": "node scripts/publish-release.cjs",
    "test:updater": "node --test --test-isolation=none test/app-updater.test.js test/release-config.test.js test/updater-close.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.handdy.timetracker",
    "productName": "CRM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app-updater.js",
      "timer-lock.js",
      "lock-overlay.html",
      "preload.js",
      "api-config.js",
      "idle-policy-defaults.json",
      "renderer.js",
      "index.html",
      "dashboard.html",
      "style.css",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "CRM-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "selectPerMachineByDefault": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CRM"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Upsilon-GDC",
        "repo": "handdy-workspace",
        "private": false,
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.0.0",
    "semver": "^7.7.3"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
